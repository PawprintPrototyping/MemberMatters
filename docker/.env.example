# Example environment file for docker-compose.yml.

# Development, Production or Staging. Compose defaults to Production when
# this is unset or blank, so set it explicitly for local dev. Production
# and Staging both require MM_SECRET_KEY and MM_ALLOWED_HOSTS below.
MM_ENV=Development

# Django SECRET_KEY. Required when MM_ENV=Production. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(50))'
MM_SECRET_KEY=

# Comma-separated list of hostnames the app should accept. Required when
# MM_ENV=Production. Example: portal.example.org,www.example.org
MM_ALLOWED_HOSTS=

# Redis URL used by the webapp, celery worker, celery beat, and the
# celery-exporter sidecar. Override to point at an external redis
# instance; leave unset to use the mm-redis service defined in compose.
MM_REDIS_URL=redis://mm-redis:6379/0

# Image for the app services. Set this to deploy CI-built images, e.g.
# ghcr.io/pawprintprototyping/membermatters:staging
MM_IMAGE=membermatters/membermatters
