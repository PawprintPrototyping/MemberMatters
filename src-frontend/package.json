    "@sentry/vue": "^10.73.0",
    "@stripe/stripe-js": "^9.15.0",
    "animate.css": "^4.1.1",
    "apexcharts": "^7.1.0",
    "axios": "^1.20.0",
    "core-js": "^3.22.2",
    "csv-stringify": "^6.5.1",
