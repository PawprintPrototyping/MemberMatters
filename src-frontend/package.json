{
  "name": "frontend",
  "version": "3.8.0",
  "description": "The MemberMatters frontend",
  "productName": "MemberMatters",
  "author": "Jaimyn Mayer <github@jaimyn.dev>",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "dev:electron": "quasar dev -m electron",
    "dev:ios": "quasar dev -m capacitor -T ios",
    "dev:android": "quasar dev -m capacitor -T android",
    "build": "quasar build -m spa",
    "build:pwa": "quasar build -m pwa",
    "build:ios": "API_BASE_URL=https://portal.brisbanemaker.space quasar build -m capacitor -T ios --ide",
    "build:android": "quasar build -m capacitor -T android --ide",
    "build:electron": "quasar build -m electron",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "lint": "npm run format && eslint --cache --fix --ext .js,.vue,.ts ./",
    "lint:precommit": "npm run format && eslint --ext .js,.ts,.vue ./",
    "icons": "icongenie generate -i app-icon.png",
    "icons:bg": "icongenie generate -i app-icon.png -b app-bg.png"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/storage": "^1.2.5",
    "@ionic/pwa-elements": "^3.0.1",
    "@quasar/cli": "^5.0.7",
    "@quasar/extras": "^2.0.4",
    "@rollup/plugin-inject": "^5.0.3",
    "@sentry/vue": "^10.73.0",
    "@stripe/stripe-js": "^9.15.0",
    "address": "^2.0.3",
    "animate.css": "^4.1.1",
    "apexcharts": "^7.1.0",
    "axios": "^1.20.0",
    "core-js": "^3.22.2",
    "crypto-js": "^4.1.1",
    "csv-stringify": "^6.5.1",
    "dayjs": "^1.11.1",
    "dompurify": "^3.4.5",
    "events": "^3.3.0",
    "html-to-image": "^1.11.13",
    "http-proxy": "^1.18.1",
    "idle-timeout": "^2.0.1",
    "jsrsasign": "^11.1.5",
    "libphonenumber-js": "^1.13.2",
    "node-stdlib-browser": "^1.2.0",
    "prettier": "^3.9.6",
    "qrcode": "^1.4.4",
    "quasar": "^2.12.2",
    "util": "^0.12.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vue": "^3.2.33",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0",
    "vue2-transitions": "^0.3.0",
    "vue3-apexcharts": "^1.5.3",
    "vuex": "^4.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@intlify/vite-plugin-vue-i18n": "^7.0.0",
    "@intlify/vue-i18n-loader": "^5.0.0",
    "@quasar/app-vite": "^3.8.1",
    "@quasar/icongenie": "^6.1.6",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vue/cli-service": "^5.0.4",
    "@vue/eslint-config-airbnb": "^8.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.4.2",
    "babel-eslint": "^10.0.1",
    "devtron": "^1.4.0",
    "electron": "^44.1.1",
    "electron-debug": "^4.1.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-packager": "^17.1.2",
    "eslint": "^10.9.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite-plugin-rewrite-all": "^1.0.1",
    "xcode": "^3.0.1"
  },
  "engines": {
    "node": "^24 || ^22 || ^20",
    "npm": ">= 10",
    "yarn": ">= 1.21.1"
  }
}
